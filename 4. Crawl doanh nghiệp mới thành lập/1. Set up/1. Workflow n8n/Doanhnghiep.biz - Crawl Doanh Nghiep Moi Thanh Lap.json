    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $input.item.json.data || \"\";\n\nconst validate = (val) => {\n  const s = String(val || '').trim();\n  return (!s || s === 'null' || s === 'undefined') ? 'Chua cap nhat' : s;\n};\n\nconst stripTags = (str) => str.replace(/<[^>]+>/g, '').trim();\n\n// MST\nconst canonicalMatch = html.match(/href=[\"']https:\\/\\/doanhnghiep\\.biz\\/(\\d{10,13})-[^\"']+[\"']/);\nconst mst = canonicalMatch ? canonicalMatch[1] : '';\n\n// Tên công ty - lấy phần giữa \"MST - TÊN - DoanhNghiep.Biz\"\nconst titleMatch = html.match(/<title>([^<]+)<\\/title>/i);\nlet tenCongTy = 'Chua cap nhat';\nif (titleMatch) {\n  const parts = titleMatch[1].split(/\\s*[-–]\\s*/);\n  tenCongTy = parts.length >= 3\n    ? parts.slice(1, -1).join(' - ').trim()\n    : parts[0].trim();\n}\n\n// Người đại diện\nconst nddMatch = html.match(/Người đại diện<\\/td>\\s*<td[^>]*>[\\s\\S]*?<span[^>]*>\\s*<a[^>]*>([^<]+)<\\/a>/i);\nconst nguoiDaiDien = nddMatch ? validate(nddMatch[1].trim()) : 'Chua cap nhat';\n\n// Email decode Cloudflare\nconst cfEmailMatch = html.match(/data-cfemail=[\"']([^\"']+)[\"']/i);\nlet email = 'Chua cap nhat';\nif (cfEmailMatch) {\n  const encoded = cfEmailMatch[1];\n  const key = parseInt(encoded.substr(0, 2), 16);\n  let decoded = '';\n  for (let i = 2; i < encoded.length; i += 2) {\n    decoded += String.fromCharCode(parseInt(encoded.substr(i, 2), 16) ^ key);\n  }\n  email = validate(decoded);\n}\n\n// Các trường từ table\nconst getField = (label) => {\n  const pattern = new RegExp(label + '[^<]*<\\\\/td>\\\\s*<td[^>]*>(.*?)<\\\\/td>', 'is');\n  const match = html.match(pattern);\n  return match ? validate(stripTags(match[1])) : 'Chua cap nhat';\n};\n\nconst dienThoai = getField('Điện thoại');\nconst ngayCap   = getField('Ngày cấp');\nconst nganhNghe = getField('Ngành nghề');\nconst tinhTrang = getField('Tình trạng');\nconst loaiHinh  = getField('Loại hình DN');\n\n// Địa chỉ - không cắt ở dấu phẩy\nconst diaChiMeta = html.match(/Địa chỉ:\\s*([^\"<]+)/i);\nconst diaChi = diaChiMeta ? validate(diaChiMeta[1].trim()) : 'Chua cap nhat';\n\nconst now = new Date();\nconst ngayCrawl = `${now.getDate()}/${now.getMonth()+1}/${now.getFullYear()}`;\n\nreturn {\n  MST: validate(mst),\n  TenCongTy: validate(tenCongTy),\n  NguoiDaiDien: nguoiDaiDien,\n  DiaChi: diaChi,\n  DienThoai: dienThoai,\n  Email: email,\n  TinhTrang: tinhTrang,\n  LoaiHinhDN: loaiHinh,\n  NgayCap: ngayCap,\n  NganhNghe: nganhNghe,\n  NgayCrawl: ngayCrawl,\n  Link: `https://doanhnghiep.biz/${mst}`\n};"
      },
