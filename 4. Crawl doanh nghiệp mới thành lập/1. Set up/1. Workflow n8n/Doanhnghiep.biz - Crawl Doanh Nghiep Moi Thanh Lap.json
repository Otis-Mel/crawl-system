    {
      "parameters": {
        "jsCode": "const currentBatch = $input.all();\n\nconst normalizeMST = (val) => {\n  let s = String(val || '')\n    .replace(/\\s+/g, '')\n    .replace(/^\"+|\"+$/g, '')\n    .trim();\n  if (s && /^\\d+$/.test(s) && s.length < 10) {\n    s = s.padStart(10, '0');\n  }\n  return s;\n};\n\nconst sheetData = $('Read Existing MST1').all();\nconst existingMSTs = new Set(\n  sheetData\n    .map(item => normalizeMST(item.json.MST))\n    .filter(Boolean)\n);\n\n// Dedup nội bộ + lọc sheet cùng lúc\nconst seenInBatch = new Set();\nconst newOnes = [];\nconst skipped = { duplicate_internal: 0, in_sheet: 0, no_mst: 0 };\n\nfor (const item of currentBatch) {\n  const mst = normalizeMST(item.json.mst || item.json.MST);\n  \n  if (!mst) {\n    skipped.no_mst++;\n    continue;\n  }\n  if (seenInBatch.has(mst)) {\n    skipped.duplicate_internal++;\n    continue;\n  }\n  if (existingMSTs.has(mst)) {\n    skipped.in_sheet++;\n    seenInBatch.add(mst);\n    continue;\n  }\n  \n  seenInBatch.add(mst);\n  newOnes.push(item);\n}\n\nconsole.log(`NEW: ${newOnes.length}`);\nconsole.log(`SKIP - in_sheet: ${skipped.in_sheet} | dup_internal: ${skipped.duplicate_internal} | no_mst: ${skipped.no_mst}`);\n\nif (newOnes.length > 0) return newOnes;\n\nreturn [{ json: {\n  status: \"No new companies found\",\n  scanned: currentBatch.length,\n  existing_mst_count: existingMSTs.size,\n  skipped\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
