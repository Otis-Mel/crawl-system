    {
      "parameters": {
        "jsCode": "const currentBatch = $input.all();\n\n// ✅ Reset static data mỗi lần chạy workflow mới\nconst staticData = $getWorkflowStaticData('node');\nstaticData.seenMSTs = []; // Xóa sạch dữ liệu cũ\n\nconst seenSet = new Set(staticData.seenMSTs);\n\nconst uniqueItems = [];\nfor (const item of currentBatch) {\n  const mst = String(item.json.mst || '').replace(/\\s+/g, '').trim();\n  if (!mst || seenSet.has(mst)) continue;\n  seenSet.add(mst);\n  uniqueItems.push(item);\n}\n\nstaticData.seenMSTs = [...seenSet];\n\nreturn uniqueItems.length > 0 ? uniqueItems : [];"
      },
