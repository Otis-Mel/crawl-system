      "parameters": {
        "jsCode": "const html = $('Lấy html trang ').first().json.data || \"\";\n\nconst pageNumbers = [...html.matchAll(/[?&]p=(\\d+)/gi)]\n  .map(m => parseInt(m[1]))\n  .filter(n => !isNaN(n) && n < 9999);\n\nconst totalPages = pageNumbers.length > 0 ? Math.max(...pageNumbers) : 1;\n\nconst now = new Date();\nconst mm = String(now.getMonth() + 1).padStart(2, '0');\nconst yyyy = now.getFullYear();\nconst baseUrl = `https://doanhnghiep.biz/thang-${mm}/${yyyy}`;\nconst workerBase = `https://crawlmst.derekpham0309.workers.dev/?url=`;\n\nconst items = [];\nfor (let page = 1; page <= totalPages; page++) {\n  const targetUrl = page === 1\n    ? baseUrl\n    : `https://doanhnghiep.biz/?p=${page}`;\n\n  items.push({\n    json: {\n      page,\n      url: workerBase + encodeURIComponent(targetUrl),\n      totalPages\n    }\n  });\n}\n\nreturn items;"
      },
