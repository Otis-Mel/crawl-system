    {
      "parameters": {
        "jsCode": "const html = $input.item?.json?.data || \"\";\nif (!html) return [];\n\n// Lấy tất cả link công ty - href dạng /XXXXXXXXXX-ten-cong-ty\nconst allLinks = [...html.matchAll(\n  /<a[^>]+href=[\"'](\\/\\d{10,13}-[^\"']+)[\"'][^>]*>(.*?)<\\/a>/gis\n)].map(m => ({\n  href: m[1],\n  text: m[2].replace(/<[^>]+>/g, '').trim()\n}));\n\n// Mỗi công ty có 2 link cùng href: [0]=tên công ty, [1]=MST\n// Group theo href\nconst grouped = {};\nfor (const link of allLinks) {\n  if (!grouped[link.href]) grouped[link.href] = [];\n  grouped[link.href].push(link.text);\n}\n\n// Build output - mỗi công ty 1 item\nconst companies = [];\nfor (const [href, texts] of Object.entries(grouped)) {\n  // Extract MST từ href: /0111456197-cong-ty-...\n  const mstMatch = href.match(/^\\/(\\d{10,13})-/);\n  const mst = mstMatch ? mstMatch[1] : '';\n  \n  // Tên công ty = text dài nhất (không phải số thuần)\n  const tenCongTy = texts.find(t => t.length > 10 && !/^\\d+$/.test(t)) || '';\n  \n  if (!mst || !tenCongTy) continue;\n\n  companies.push({\n    json: {\n      mst,\n      tenCongTy,\n      detailUrl: `https://doanhnghiep.biz${href}`\n    }\n  });\n}\n\nreturn companies;"
      },
